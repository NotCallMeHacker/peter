# Supervisor (service A) environment. Copy to .env and adjust.
# `npm start` also picks up the repo-root ../.env when present.

# Stable identity of this instance — must match a row in app."RunnerInstances"
# (created via the dashboard-gated `runner-keys` edge function).
INSTANCE_ID=dev-a1

# B's bridge endpoint (the web app's /api/agent-runner).
# Dev on the same machine: ws://localhost:3000/api/agent-runner
BRIDGE_URL=ws://localhost:3000/api/agent-runner

# Trust anchor for B when BRIDGE_URL is wss:// (PEM bundle). Required there:
# refusing to skip TLS verification is deliberate — a wss:// connection with no
# trust anchor would accept any MITM as "B".
#BRIDGE_CA_PATH=/etc/ssl/certs/b-ca.pem

# Where this instance keeps its Ed25519 keypair + public entry.
# Default: <repo>/secrets/instances (generated on first start, key file 0600).
#REGISTRY_DIR=

# Tuning (ms).
#AUTH_TIMEOUT_MS=5000
#RECONNECT_MS=5000
#HEARTBEAT_MS=30000
# --- Docker runtime (DinD: the supervisor's own inner daemon) ---
# Socket of the inner daemon (inside the supervisor container).
#DOCKER_HOST=/var/run/docker.sock
# Boot retry budget for docker ping — the inner daemon needs 10-20s to create its socket.
#DOCKER_READY_TIMEOUT_MS=60000

# --- Directories (container-absolute; override to run on a host) ---
# Bind-mounted from the host; the inner daemon must be able to see them as bind sources.
#GIT_CACHE_DIR=/var/lib/peter/git
#SOCKETS_DIR=/var/lib/peter/sockets
#WORKTREES_DIR=/var/lib/peter/worktrees
#LOGS_DIR=/var/lib/peter/logs

# --- Agent image ---
#AGENT_IMAGE=peter-agent
#AGENT_IMAGE_TAG=dev
# Comma-separated allowlist of images a payload may name (payload wins; config is default).
#AGENT_IMAGE_ALLOWLIST=

# --- Task runtime behaviour ---
# ms of bridge outage before live containers are paused (never killed).
#OFFLINE_PAUSE_MS=30000
# ms between container stats polls.
#CONTAINER_POLL_MS=5000
# Test mode: keep containers after completion.
#KEEP_CONTAINERS_ON_COMPLETE=0
# Concurrent task capacity; beyond it supervisor.status reports "full".
#MAX_CONCURRENT_TASKS=4
# Agent runtime — only "pi" in the POC.
#AGENT_RUNTIME=pi
# ms budget for a task's startupScript.
#STARTUP_SCRIPT_TIMEOUT_MS=600000
