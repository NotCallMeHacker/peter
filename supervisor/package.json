{
    "name": "peter-supervisor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Agent supervisor: runs agent runtimes and talks to the web bridge over WSS.",
    "engines": {
        "node": ">=24.6"
    },
    "scripts": {
        "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/*.spec.ts"
    },
    "devDependencies": {
        "@types/dockerode": "^4.0.2",
        "@types/node": "^20",
        "@types/ws": "^8.18.2",
        "typescript": "^5"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^2.12.0",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "dockerode": "^5.0.1",
        "ws": "^8.23.0"
    }
