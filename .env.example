SUPERTOKENS_CONNECTION_URI=http://localhost:3567
WEB_PORT=3000
# Supabase REST API the web app reads the kanban data from.
# In the compose network the gateway is api-gw:8000; the real keys live in
# supabase/.env (generate them with `sh supabase/utils/generate-keys.sh`).
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
DB_SCHEMA=app
# Signs the per-request tokens that carry the caller's id to PostgREST (RLS).
# Copy JWT_SECRET from supabase/.env — PostgREST validates against it.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
