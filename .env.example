# Root environment for docker compose interpolation + host-side tools.
# Copy to .env and fill in.

# Change the web app's host port (default 3000). GoTrue's GOTRUE_SITE_URL in
# supabase/.env points at http://localhost:3000 — keep them in sync.
WEB_PORT=3000

# Supabase REST API the host-side scripts talk to (the web app gets its own
# copy via compose). In the compose network the gateway is api-gw:8000; the
# real keys live in supabase/.env (generate them with
# `sh supabase/utils/generate-keys.sh`).
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub OAuth for GoTrue sign-in (supabase/docker-compose.yml reads these).
# App callback: http://localhost:8000/auth/v1/callback
# Set GITHUB_ENABLED=true to turn the provider on.
GITHUB_ENABLED=true
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Database — the canonical home for DB_* is web/.env (sequelize-cli loads it
# from there for migrations/seeds; web/db/config/config.js). These root copies
# are only used if you export them into your shell. The web container itself
# receives NO database credentials, and .agents/dbq.sh needs none either
# (docker exec into the db container).
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_LOGGING=false
DB_SCHEMA=app

# NOTE: SUPERTOKENS_CONNECTION_URI and SUPABASE_JWT_SECRET were removed —
# SuperTokens is gone and the web app no longer mints tokens (GoTrue issues
# the session; PostgREST validates it against JWT_SECRET inside supabase/.env).