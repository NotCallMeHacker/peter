# Web app environment (web/.env) — everything the Next.js app itself needs.
# Copy to web/.env and fill in. No secrets are required for auth: sessions are
# issued and validated by GoTrue, and the app only forwards that token.

# Supabase REST API (PostgREST) — the kanban board reads the `app` schema
# through PostgREST. localhost:8000 is the API gateway on the host; inside the
# compose network it is http://api-gw:8000. SUPABASE_ANON_KEY is the ANON_KEY
# value in supabase/.env (it is only sent as the `apikey` header the gateway
# expects; it carries no user identity, so RLS matches nothing without a
# GoTrue session token alongside it).
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key

# Schema that holds Projects, Columns, Issues, … (must also be listed in
# PGRST_DB_SCHEMAS in supabase/.env).
DB_SCHEMA=app

# Database credentials (DB_HOST / DB_PASSWORD / …) also live in THIS file —
# but only sequelize-cli reads them (db/config/config.js loads this .env for
# migrations and seeders; `npx sequelize-cli db:migrate` in web/). No code
# under app/ touches them: the Next.js runtime has no direct Postgres access
# and no token-minting JWT secret — board reads go through PostgREST with the
# session token. `.agents/dbq.sh` needs no env at all (docker exec into the
# db container as user postgres).
#
# DB_* expected by db/config/config.js: DB_DIALECT=postgres, DB_HOST=localhost,
# DB_PORT=5433 (host-mapped port), DB_NAME=postgres, DB_USER=postgres,
# DB_PASSWORD=<POSTGRES_PASSWORD from supabase/.env>, DB_SCHEMA=app,
# DB_LOGGING=false.