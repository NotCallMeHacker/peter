SUPERTOKENS_CONNECTION_URI=http://localhost:3567
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Database
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_LOGGING=false
DB_SCHEMA=app

# Supabase REST API — the kanban board reads the `app` schema through PostgREST
# (supabase-js). localhost:8000 is the API gateway on the host; inside the
# compose network it is http://api-gw:8000. The keys are the ANON_KEY /
# SERVICE_ROLE_KEY values in supabase/.env (they are signed with its JWT_SECRET).
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Signs the per-request tokens that carry the caller's id to PostgREST, so the
# RLS policies on the app schema know who is asking. Same value as JWT_SECRET
# in supabase/.env (PostgREST validates against it).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
