{
    "name": "peter-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm run stack:up && next dev",
        "db:migrate": "npx sequelize-cli db:migrate",
        "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
        "db:schema:move": "node db/scripts/move-to-schema.js",
        "stack:up": "docker compose -f ../docker-compose.yml stop web && docker compose -f ../docker-compose.yml -f ../docker-compose.no-web.yml up -d",
        "stack:down": "docker compose -f ../docker-compose.yml down",
        "build": "next build",
        "start": "next start",
        "lint": "next lint"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/plus-jakarta-sans": "^5.3.0",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@supabase/supabase-js": "^2.119.0",
        "lucide-react": "^1.67.0",
        "next": "latest",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "pg": "^8.23.1",
        "react": "^19",
        "react-dom": "^19",
        "sequelize": "^6.37.8"
    },
    "devDependencies": {
        "@types/cookie": "^0.5.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^16.4.5",
        "eslint": "^8",
        "eslint-config-next": "13.5.4",
        "sequelize-cli": "^6.6.5",
        "ts-node": "^10.9.2"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "@swc/core@1.16.21": true,
        "unrs-resolver@1.12.2": true
    }
}
