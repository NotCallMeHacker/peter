{
    "name": "supertokens-app-dir",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm run stack:up && next dev",
        "stack:up": "docker compose -f ../docker-compose.yml stop web && docker compose -f ../docker-compose.yml -f ../docker-compose.no-web.yml up -d",
        "stack:down": "docker compose -f ../docker-compose.yml down",
        "build": "next build",
        "start": "next start",
        "lint": "next lint"
    },
    "dependencies": {
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "next": "latest",
        "react": "^19",
        "react-dom": "^19",
        "supertokens-auth-react": "latest",
        "supertokens-node": "latest"
    },
    "devDependencies": {
        "@types/cookie": "^0.5.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^8",
        "eslint-config-next": "13.5.4",
        "typescript": "^5"
    }
}
